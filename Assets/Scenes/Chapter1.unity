  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneSubtitles
  captions:
  - start: 2
    end: 5.4518366
    text: You've been dreaming about Matha a lot lately, kid.
  - start: 5.5518365
    end: 9.761225
    text: I just... have a bad feeling about things, Uncle.
  - start: 9.861224
    end: 14.775918
    text: Shake it off. Eat up. Breakfast is ready.
