--- !u!114 &467579782
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 467579778}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49b7791878d846647b02ca388b8fcccf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneSubtitles
  captions:
  - start: 4.5
    end: 10.030916
    text: Our shelter's rations won't last more than two or three days.
  - start: 10.030916
    end: 16.377869
    text: If you think you've got the guts, go join my old pal Ethan downstairs.
  - start: 16.377869
    end: 20.730064
    text: He's waiting at the lowest parking garage level.
  - start: 20.730064
    end: 25.08226
    text: They've only got three or four volunteers ready.
  - start: 25.08226
    end: 31.566532
    text: Sigh... Plenty of mouths to feed around here, but damn few spines.
  - start: 31.666533
    end: 36.206005
    text: Uh... alright. If they're that short on hands, I'll go.
  - start: 36.206005
    end: 39.924904
    text: But I never said I was fearless, Uncle.
  - start: 40.024902
    end: 43.542545
    text: Just make sure you come back in one piece.
  - start: 43.542545
    end: 48.648983
    text: I'd hate having to picture what your corpse looks like.
  - start: 48.74898
    end: 51.417145
    text: Right... I'll go pack my gear.
  - start: 51.817146
    end: 52.917145
    text: Get moving.
